{
  "name": "giecko",
  "version": "0.6.0",
  "description": "Turn GitHub Actions into a browser-accessible dev environment",
  "main": "dist/cli.js",
  "bin": {
    "giecko": "./bin/giecko.js"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "scripts",
    "terms.txt",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p .",
    "sync": "node scripts/sync-templates.js",
    "check": "node scripts/check.js",
    "prepublishOnly": "npm run build && npm run check && npm run sync"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Seigh-sword/Giecko.git"
  }
}
