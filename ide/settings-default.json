{
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.startupEditor": "none",
  "editor.fontFamily": "JetBrains Mono, Fira Code, Menlo, Consolas, monospace",
  "editor.fontSize": 15,
  "editor.fontLigatures": true,
  "editor.cursorBlinking": "smooth",
  "editor.smoothScrolling": true,
  "editor.renderWhitespace": "boundary",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontFamily": "JetBrains Mono, Fira Code, Menlo, Consolas, monospace",
  "workbench.colorCustomizations": {
    "editor.background": "#0B0F14",
    "sideBar.background": "#0B111C",
    "activityBar.background": "#070B12",
    "terminal.background": "#0B0F14",
    "statusBar.background": "#0B111C",
    "titleBar.activeBackground": "#0B111C"
  },
  "update.mode": "none",
  "extensions.autoUpdate": false,
  "extensions.autoCheckUpdates": false,
  "telemetry.telemetryLevel": "off",
  "git.autofetch": true,
  "git.confirmSync": false,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 2000,
  "errorLens.enabled": true,
  "prettier.requireConfig": false,
  "editor.formatOnSave": true,
  "editor.minimap.enabled": true,
  "window.dialogStyle": "custom",
  "workbench.editor.wrapTabs": true
}
